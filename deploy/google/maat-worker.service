[Unit]
Description=Ma'at Attestcoin settlement worker
Documentation=https://github.com/Dozie2001/MA-AT
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=maat
Group=maat
WorkingDirectory=/opt/maat/worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/maat-worker.env
ExecStart=/usr/local/bin/node /opt/maat/worker/dist/watchSettlements.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

StateDirectory=maat-worker
StateDirectoryMode=0750
ReadWritePaths=/var/lib/maat-worker

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=maat-worker

[Install]
WantedBy=multi-user.target
